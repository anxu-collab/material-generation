# laox_director_lab 环境变量模板（复制为实际值时不要提交；脚本只从环境变量读，不回显）
# 本文件是模板，不含任何真实密钥。

# --- Toonflow MCP（本地部署，凭证由 runtime/toonflow-data/settings.json 管理，无需 env）---
# 如需在外部工具显式传 token（官方 stdio 模式），才使用：
# TOONFLOW_MCP_TOKEN=<从 Toonflow 设置页复制的访问凭证，勿提交>

# --- VBench（缓存只落目标目录内）---
VBENCH_CACHE_DIR=F:/codex/laox_director_lab/runtime/cache/vbench
VBENCH2_CACHE_DIR=F:/codex/laox_director_lab/runtime/cache/vbench2
HF_HOME=F:/codex/laox_director_lab/runtime/cache/hf
TORCH_HOME=F:/codex/laox_director_lab/runtime/cache/torch

# --- MiniMax H3 / AutoDL ART（h3-autodl-v1 真实契约，2026-10-11 确认；旧 H3_API_KEY/H3_BASE_URL/H3_MODEL 为未验证占位，已废弃）---
# 唯一真实通道 = 老X H3 Runtime 的 settings resolver：默认读老X app/api/autodl.env，
# 环境变量覆盖优先（lab 执行实例经私有注入委托同一 resolver，无需重复导出已存在凭据）。
# 本模块不读值、不回显、不拷贝密钥；下方留空 = 未在环境中覆盖。付费提交在
# runtime/h3-autodl-v1/authorization/ 下的人工授权记录（含可核验估价依据）之前保持阻塞。
AUTODL_ART_TOKEN=
AUTODL_ART_BASE_URL=
# AUTODL_WORKFLOW_ID 已锁定 minimax_h3_z0903（Runtime 校验），禁止覆盖。

# --- 官方 MiniMax 中国站直连（h3-minimax-official-v1，2026-10-11 用户授权"全能视频参考接入官方的minimax"）---
# 独立于 AutoDL 通道的第二供应商（Ref2VA 真实视频参考），契约与价目快照见
# config/minimax_official.json。密钥只从环境变量读取：不回显、不落日志、不落配置、
# 不做 AutoDL key 回退；付费提交在 runtime/h3-minimax-official-v1/authorization/ 下
# 的人工授权记录（绑定指纹+参考哈希+价目哈希、max_calls=1、预算、新鲜估价）之前保持阻塞。
# doctor 默认离线（凭据只报布尔）；--live-auth 为单次只读 GET，无 key 时如实 not_run。
MINIMAX_API_KEY=
# 可选：仅接受精确中国站域名（钉死；其他值在任何 key/网络动作之前被拒绝）
MINIMAX_API_BASE_URL=https://api.minimax.cn
